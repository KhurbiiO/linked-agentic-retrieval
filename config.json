{
  "model": {
    "identifier": "ollama:llama3.2",
    "temperature": 0
  },
  "agent": {
    "max_rounds": 5,
    "max_candidate_urls": 20
  },
  "retrieval": {
    "max_results_per_page": 12,
    "max_links_per_page": 10,
    "scoring_method": "semantic",
    "semantic_model_name": "sentence-transformers/all-MiniLM-L6-v2",
    "traverse_links": false,
    "evidence_mode": "filtered",
    "extraction_prompt_max_chars_per_page": 50000,
    "excluded_url_extensions": [
      ".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg", ".avif", ".ico",
      ".mp4", ".webm", ".mov", ".avi", ".mkv", ".m3u8",
      ".mp3", ".wav", ".ogg", ".m4a", ".aac",
      ".css", ".js", ".map", ".woff", ".woff2", ".ttf", ".eot"
    ]
  },
  "extractor": {
    "timeout_seconds": 30,
    "link_context_max_fields": 12,
    "link_context_max_chars": 1000,
    "link_context_child_depth": 2
  },
  "tracing": {
    "enabled": true
  }
}
